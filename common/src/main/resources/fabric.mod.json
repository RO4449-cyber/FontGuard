{
  "schemaVersion": 1,
  "id": "fontguard",
  "version": "${version}",
  "name": "FontGuard",
  "description": "Protects your computer from malicious fonts in server resource packs, like the minecraft2shell exploit. Blocks server fonts, scans all other fonts, and turns off risky font code. Client-side, works out of the box.",
  "authors": ["RO4449", "Claude (Anthropic)"],
  "contact": {
    "homepage": "https://github.com/RO4449-cyber/FontGuard",
    "sources": "https://github.com/RO4449-cyber/FontGuard",
    "issues": "https://github.com/RO4449-cyber/FontGuard/issues"
  },
  "license": "LicenseRef-FontGuard-NonCommercial",
  "icon": "assets/fontguard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.fontguard.FontGuard"]
  },
  "mixins": ["fontguard.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${mcrange}",
    "java": "${java}"
  }
}
